# Address of the Enhakkore API, with or without a trailing /api.
# Either name works. On Vercel, prefer API_URL: Vercel refuses a NEXT_PUBLIC_
# variable created with the Secret type.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Ask Enhakkore (the question box, bottom right of every public page)
# ---------------------------------------------------------------------------
# Without a key the assistant answers from the facts published on this site —
# prices, dates, inclusions, payment and contact details, read straight from
# src/content. That costs nothing, works offline, and cannot invent anything.
#
# With a key, the same facts are handed to Claude as the only source it may
# use, which copes with questions phrased in ways a keyword list cannot. If the
# key is missing, rate-limited or the API is down, it falls back to the offline
# answers rather than failing.
#
# Get one at https://console.anthropic.com → API keys. Set it in Vercel as a
# normal (not public) environment variable — it must never reach the browser.
# ANTHROPIC_API_KEY=sk-ant-...
