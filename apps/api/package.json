{
  "name": "@enhakkore/api",
  "version": "0.1.0",
  "private": true,
  "description": "Enhakkore platform API — marketplace, bookings, trip communities and impact.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run datasource && prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "npm run datasource && prisma generate",
    "db:push": "npm run datasource && prisma db push --skip-generate && prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "npm run datasource && prisma db push --force-reset --skip-generate && prisma generate && tsx prisma/seed.ts",
    "datasource": "node scripts/sync-datasource.js",
    "db:deploy": "npm run datasource && prisma db push --skip-generate && prisma generate",
    "remote:push": "node scripts/remote.js push",
    "remote:seed": "node scripts/remote.js seed",
    "remote:studio": "node scripts/remote.js studio",
    "remote:reset": "node scripts/remote.js reset"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@enhakkore/shared": "*",
    "@prisma/client": "^6.3.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.7",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
