// ---------------------------------------------------------------------------
// ENHAKKORE — Travel & Impact
// Platform data model
//
// Provider note: SQLite is used for zero-setup local development. Prisma does
// not support native enums or Json columns on SQLite, so status fields are
// String columns constrained by the unions in @enhakkore/shared, and structured
// lists are stored as JSON strings (read/written through src/lib/json.ts).
// Switching `provider` to "postgresql" is the only change needed to move to a
// production database; column types stay compatible.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id                String    @id @default(cuid())
  /// Unique public handle shown in chats, teams and profiles (no phone or email is ever shown).
  username          String?   @unique
  /// Profile card wallpaper.
  coverImage        String?
  /// Who sees each profile field: { field: PUBLIC | MEMBERS | PRIVATE }.
  profileFields     String    @default("{}")
  /// Enhakkore Nearby: OFF | M4 | M10. Off unless the member turns it on.
  nearbyMode        String    @default("OFF")
  /// Notification preferences and quiet hours (JSON).
  notificationPrefs String    @default("{}")
  email             String    @unique
  passwordHash      String
  name              String
  /// TRAVELER | ORGANIZER | ADMIN
  role              String    @default("TRAVELER")
  /// ACTIVE | SUSPENDED | PENDING
  status            String    @default("ACTIVE")
  avatarUrl         String?
  phone             String?
  country           String?
  city              String?
  bio               String?
  /// Marks records created by the demo seed so the UI can label them honestly.
  isDemo            Boolean   @default(false)
  /// Set whenever the password changes. Session tokens issued before this
  /// moment are rejected, so a reset signs the account out everywhere.
  passwordChangedAt DateTime?

  /// Connect profile. Never holds a home address or a live location.
  headline          String?
  /// JSON string arrays.
  interests         String    @default("[]")
  activityPrefs     String    @default("[]")
  /// PUBLIC (any member may find them) | MEMBERS (same) | HIDDEN (not listed)
  profileVisibility String    @default("MEMBERS")
  /// Set for staff. Null for members and for the owner (role ADMIN has everything).
  adminRoleId       String?
  lastLoginAt       DateTime?
  /// Why an account was suspended, for the record.
  statusReason      String?
  /// Two-factor sign-in (authenticator app, TOTP). The secret is stored
  /// encrypted with the server's key; it is never sent back to a browser.
  totpSecret        String?
  totpEnabled       Boolean   @default(false)
  /// Which version of the member terms the person accepted, and when.
  termsVersion      String?
  termsAcceptedAt   DateTime?

  /// Date of birth: age-appropriate protections (under 18: no nearby discovery,
  /// no message requests from non-friends). Never shown to other members.
  dateOfBirth     DateTime?
  /// Show others when you have read their private messages.
  readReceipts    Boolean   @default(true)
  /// Games, platforms and gamer tags (JSON). Shown on the gaming profile per privacy settings.
  gamingProfile   String    @default("{}")
  /// Opt-in: receive nearby gaming invitations (adults only, needs a recent approximate location).
  nearbyGaming    Boolean   @default(false)
  /// Approximate position (rounded to about 500 m) used only for 2 km server-side matching.
  /// Never returned to any other member, never exact GPS.
  approxLat       Float?
  approxLng       Float?
  approxLocatedAt DateTime?
  /// Lets accepted friends see an approximate distance band. Off by default.
  friendLocation  Boolean   @default(false)
  /// Nia: keep conversation history.
  niaHistory      Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adminRole            AdminRole?              @relation(fields: [adminRoleId], references: [id], onDelete: SetNull)
  sessions             Session[]
  connectionsSent      Connection[]            @relation("ConnectionRequester")
  connectionsReceived  Connection[]            @relation("ConnectionAddressee")
  blocksMade           Block[]                 @relation("BlockBlocker")
  blocksReceived       Block[]                 @relation("BlockBlocked")
  activityRequests     ActivityParticipant[]
  savedItems           SavedItem[]
  pollVotes            PollVote[]
  placeReviews         PlaceReview[]
  organizer            Organizer?
  passwordResetTokens  PasswordResetToken[]
  bookings             Booking[]
  donations            Donation[]
  reviews              Review[]
  messages             Message[]
  conversationMembers  ConversationMember[]
  notifications        Notification[]
  savedTrips           SavedTrip[]
  customTripRequests   CustomTripRequest[]
  verificationsHandled OrganizerVerification[] @relation("VerificationReviewer")
  moderatedTrips       Trip[]                  @relation("TripReviewer")
  communityMemberships CommunityMember[]
  tournamentEntries    TournamentEntry[]
  teamMemberships      TournamentTeamMember[]
  sessionRegistrations SessionRegistration[]
  extraRoles           UserAdminRole[]
  following            Follow[]                @relation("FollowFollower")
  followers            Follow[]                @relation("FollowFollowing")

  @@index([role])
  @@index([status])
  @@index([country, city])
}

/// A pending "forgot password" link.
///
/// Only a SHA-256 hash of the link's secret is stored, never the secret itself,
/// so someone who can read the database still cannot use a pending reset.
/// Links are single-use and short-lived; issuing a new one retires the old.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Supply side — tour operators / trip organizers
// ---------------------------------------------------------------------------

model Organizer {
  id          String  @id @default(cuid())
  userId      String  @unique
  companyName String
  slug        String  @unique
  tagline     String?
  bio         String?
  logoUrl     String?
  coverUrl    String?
  websiteUrl  String?
  country     String?
  city        String?
  yearFounded Int?
  /// JSON string array of spoken languages, e.g. ["English","Swahili"]
  languages   String  @default("[]")

  /// UNSUBMITTED | PENDING | VERIFIED | REJECTED | SUSPENDED
  verificationStatus String  @default("UNSUBMITTED")
  /// Share of each booking retained by the platform (0.10 = 10%).
  commissionRate     Float   @default(0.10)
  rating             Float?
  reviewCount        Int     @default(0)
  responseTimeHours  Int?
  isDemo             Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  trips        Trip[]
  verification OrganizerVerification?
  reviews      Review[]
  payouts      Payout[]

  @@index([verificationStatus])
}

/// Documents and details an organizer submits for admin review. Nothing here is
/// verified automatically — a human admin decides, and no badge is granted until
/// `status` is VERIFIED.
model OrganizerVerification {
  id                 String  @id @default(cuid())
  organizerId        String  @unique
  legalName          String
  registrationNumber String?
  taxId              String?
  licenseNumber      String?
  contactName        String
  contactEmail       String
  contactPhone       String
  addressLine        String?
  /// JSON array of { label, fileName, uploadedAt }. Files themselves live in
  /// object storage in production; local dev records metadata only.
  documents          String  @default("[]")
  /// Payout destination, stored as a reference only. Full bank/mobile-money
  /// credentials must live in the payment provider's vault, never here.
  payoutMethod       String?
  payoutReference    String?

  /// UNSUBMITTED | PENDING | VERIFIED | REJECTED | SUSPENDED
  status       String    @default("PENDING")
  reviewNotes  String?
  reviewedById String?
  submittedAt  DateTime  @default(now())
  reviewedAt   DateTime?

  organizer  Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  reviewedBy User?     @relation("VerificationReviewer", fields: [reviewedById], references: [id])

  @@index([status])
}

model Payout {
  id          String    @id @default(cuid())
  organizerId String
  /// Integer amount in the currency's minor unit.
  amount      Int
  currency    String    @default("TZS")
  /// INITIATED | PENDING | SUCCEEDED | FAILED
  status      String    @default("PENDING")
  reference   String?
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime  @default(now())
  settledAt   DateTime?

  organizer Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@index([organizerId, status])
}

// ---------------------------------------------------------------------------
// Inventory — destinations, trips, departures
// ---------------------------------------------------------------------------

model Destination {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique
  country   String
  region    String?
  continent String  @default("Africa")
  summary   String?
  heroImage String?
  latitude  Float?
  longitude Float?
  featured  Boolean @default(false)

  trips Trip[]

  @@index([country])
  @@index([continent])
}

model Trip {
  id            String @id @default(cuid())
  organizerId   String
  destinationId String
  title         String
  slug          String @unique
  summary       String
  description   String

  /// GROUP | PRIVATE | SAFARI | BEACH | ADVENTURE | CULTURAL | INTERNATIONAL
  type   String @default("GROUP")
  /// BUDGET | COMFORT | LUXURY
  style  String @default("COMFORT")
  /// DRAFT | PENDING_REVIEW | APPROVED | PUBLISHED | REJECTED | ARCHIVED
  status String @default("DRAFT")

  durationDays   Int
  durationNights Int
  /// Lowest advertised price, integer minor units of `currency`.
  basePrice      Int
  currency       String @default("TZS")

  heroImage    String
  /// JSON string arrays.
  gallery      String @default("[]")
  tags         String @default("[]")
  includes     String @default("[]")
  excludes     String @default("[]")
  requirements String @default("[]")

  difficulty  String?
  minAge      Int?
  rating      Float?
  reviewCount Int     @default(0)
  featured    Boolean @default(false)
  isDemo      Boolean @default(false)

  /// Optional impact project this trip channels contributions toward.
  impactProjectId String?

  /// Enhakkore Travel fields. The trip page reads all of these from here, so
  /// the owner changes a price or a date without touching code.
  subtitle            String?
  countryId           String?
  cityId              String?
  destinationLabel    String?
  departureCity       String?
  meetingPoint        String?
  accommodation       String?
  transport           String?
  minParticipants     Int?
  maxParticipants     Int?
  /// Where the trip stands operationally — see TRIP_STAGES in @enhakkore/shared.
  stage               String  @default("REGISTRATION_OPEN")
  /// JSON array of { label, note, amount, currency } — separate prices, never conversions.
  priceTiers          String  @default("[]")
  /// JSON string array of items still being confirmed.
  toConfirm           String  @default("[]")
  paymentInstructions String?
  /// JSON array of { method, kind, number, name }.
  paymentOptions      String  @default("[]")
  cancellationPolicy  String?
  /// Booking deposit per person, in the trip currency. Part of the price, never charged on top.
  depositAmount       Int?
  /// JSON array of { src, alt, credit, licence, source }.
  galleryItems        String  @default("[]")
  videoUrl            String?

  reviewedById String?
  reviewNotes  String?
  submittedAt  DateTime?
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  organizer     Organizer      @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  country       Country?       @relation(fields: [countryId], references: [id], onDelete: SetNull)
  city          City?          @relation(fields: [cityId], references: [id], onDelete: SetNull)
  destination   Destination    @relation(fields: [destinationId], references: [id])
  impactProject ImpactProject? @relation(fields: [impactProjectId], references: [id])
  reviewedBy    User?          @relation("TripReviewer", fields: [reviewedById], references: [id])

  itinerary  ItineraryDay[]
  departures TripDate[]
  bookings   Booking[]
  reviews    Review[]
  savedBy    SavedTrip[]

  @@index([status, type])
  @@index([organizerId])
  @@index([destinationId])
}

model ItineraryDay {
  id            String  @id @default(cuid())
  tripId        String
  dayNumber     Int
  title         String
  summary       String?
  /// JSON string arrays.
  activities    String  @default("[]")
  meals         String  @default("[]")
  accommodation String?
  /// "Friday, 18 December"
  label         String?
  /// JSON array of { name, detail, provisional }.
  stops         String  @default("[]")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, dayNumber])
}

/// A dated departure of a trip. Group capacity and seat counts live here, not on
/// the trip, so one listing can run many times with different sizes and prices.
model TripDate {
  id                   String    @id @default(cuid())
  tripId               String
  startDate            DateTime
  endDate              DateTime
  capacity             Int
  seatsBooked          Int       @default(0)
  /// Per-departure price override; falls back to Trip.basePrice when null.
  price                Int?
  /// OPEN | ALMOST_FULL | FULL | CLOSED | DEPARTED
  status               String    @default("OPEN")
  /// Applications close at the end of this day.
  bookingDeadline      DateTime?
  /// For the trip budget: how many people the costs were planned around.
  expectedParticipants Int?

  createdAt DateTime @default(now())

  trip         Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  bookings     Booking[]
  conversation Conversation?

  @@index([tripId, startDate])
  @@index([startDate])
}

model SavedTrip {
  id        String   @id @default(cuid())
  userId    String
  tripId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([userId, tripId])
}

// ---------------------------------------------------------------------------
// Demand side — bookings, payments, commission
// ---------------------------------------------------------------------------

model Booking {
  id         String @id @default(cuid())
  /// Human-facing code shown on confirmations, e.g. ENH-4K7Q2M.
  reference  String @unique
  tripId     String
  tripDateId String
  userId     String

  travellers    Int       @default(1)
  /// PENDING_PAYMENT | CONFIRMED | CANCELLED | REFUNDED | COMPLETED, and for
  /// trips booked by application: APPLIED | DECLINED.
  status        String    @default("PENDING_PAYMENT")
  /// AWAITING_PAYMENT | RECEIPT_SUBMITTED | UNDER_VERIFICATION | APPROVED | REJECTED | REFUNDED | CANCELLED
  paymentStatus String    @default("AWAITING_PAYMENT")
  /// CHECKOUT (paid through a gateway) | APPLICATION (reviewed by the team, paid by transfer).
  channel       String    @default("CHECKOUT")
  /// Sum of verified payments, minor units. Kept for applications, where money arrives in parts.
  amountPaid    Int       @default(0)
  /// The price tier the applicant chose, by label.
  priceTier     String?
  contactPhone  String?
  reviewedById  String?
  reviewedAt    DateTime?
  adminNotes    String?

  /// All amounts are integer minor units of `currency`, captured at booking time
  /// so later price changes never rewrite history.
  tripAmount   Int
  impactAmount Int    @default(0)
  totalAmount  Int
  platformFee  Int    @default(0)
  currency     String @default("TZS")

  impactProjectId String?
  notes           String?
  cancelledAt     DateTime?
  cancelReason    String?
  completedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip          Trip                @relation(fields: [tripId], references: [id])
  departure     TripDate            @relation(fields: [tripDateId], references: [id])
  impactProject ImpactProject?      @relation(fields: [impactProjectId], references: [id])
  travellerList BookingTraveller[]
  payments      Payment[]
  receipts      PaymentReceipt[]
  donations     Donation[]
  commission    PlatformCommission?
  review        Review?

  @@index([userId, status])
  @@index([tripId])
  @@index([status])
  @@index([tripDateId, status])
}

/// Named travellers on a booking. Kept separate from User so a member can book
/// for family or friends who do not have accounts.
model BookingTraveller {
  id        String  @id @default(cuid())
  bookingId String
  fullName  String
  email     String?
  phone     String?
  /// Free-text dietary/medical notes. Treated as sensitive: never returned to
  /// anyone but the traveller who booked, the trip's organizer, and admins.
  notes     String?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

/// A payment attempt. `provider` records which adapter handled it — in this
/// build only the in-process mock gateway exists, and rows it creates are
/// marked `simulated` so nothing can be mistaken for a real settlement.
model Payment {
  id           String  @id @default(cuid())
  bookingId    String
  /// MOCK | MOBILE_MONEY | CARD | BANK_TRANSFER
  method       String  @default("MOCK")
  provider     String  @default("mock")
  providerRef  String?
  amount       Int
  currency     String  @default("TZS")
  /// INITIATED | PENDING | SUCCEEDED | FAILED | REFUNDED
  status       String  @default("INITIATED")
  simulated    Boolean @default(true)
  failureCode  String?
  /// JSON blob of the (redacted) provider response for support/debugging.
  rawResponse  String  @default("{}")
  /// For payments recorded by hand: who checked it, and the transfer's own reference.
  recordedById String?
  note         String?

  createdAt  DateTime  @default(now())
  settledAt  DateTime?
  refundedAt DateTime?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, status])
}

/// The platform's cut of a booking, recorded as its own ledger row rather than
/// derived on the fly, so reporting stays correct when rates change.
model PlatformCommission {
  id        String   @id @default(cuid())
  bookingId String   @unique
  amount    Int
  rate      Float
  currency  String   @default("TZS")
  /// PENDING | EARNED | REVERSED
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Review {
  id          String  @id @default(cuid())
  tripId      String
  organizerId String
  userId      String
  /// Every review must point at a completed booking — this is what makes them
  /// trustworthy, and the unique constraint stops duplicate reviews.
  bookingId   String  @unique
  rating      Int
  title       String?
  body        String
  photos      String  @default("[]")
  /// Organizer's public reply.
  response    String?
  published   Boolean @default(true)

  createdAt DateTime @default(now())

  trip      Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  organizer Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([organizerId])
}

// ---------------------------------------------------------------------------
// Trip communities
// ---------------------------------------------------------------------------

/// Every departure gets exactly one private group. Membership is derived from
/// confirmed bookings — there is no way to join a conversation without one.
model Conversation {
  id            String    @id @default(cuid())
  /// Trip groups belong to a departure; other groups (events, activities, communities) use subjectType/subjectId.
  tripDateId    String?   @unique
  /// ACTIVITY | EVENT | COMMUNITY | TOURNAMENT (null for trip groups)
  subjectType   String?
  subjectId     String?
  title         String
  /// After this the group is read-only. History is kept.
  archivedAt    DateTime?
  /// TRIP | GROUP | DIRECT | GAMING (temporary chat for a gaming invitation)
  kind          String    @default("GROUP")
  /// DIRECT only: the two member ids, sorted and joined — one conversation per pair.
  directKey     String?   @unique
  /// DIRECT only: PENDING until the recipient accepts | ACCEPTED | DECLINED
  requestStatus String?
  requestedById String?
  /// GAMING chats close at this time.
  expiresAt     DateTime?
  lastMessageAt DateTime?

  createdAt DateTime @default(now())

  departure TripDate?            @relation(fields: [tripDateId], references: [id], onDelete: Cascade)
  members   ConversationMember[]
  messages  Message[]

  @@unique([subjectType, subjectId])
}

model ConversationMember {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  /// ORGANIZER | TRAVELER | ADMIN
  role           String    @default("TRAVELER")
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?
  muted          Boolean   @default(false)
  /// Private messages: archived from the inbox by this member.
  archivedAt     DateTime?
  /// "Delete chat for me": messages before this are hidden for this member.
  clearedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  body           String
  /// TEXT | ANNOUNCEMENT | SYSTEM | IMAGE
  kind           String    @default("TEXT")
  /// JSON array of attachment URLs.
  attachments    String    @default("[]")
  pinned         Boolean   @default(false)
  replyToId      String?
  /// Unsent by its author: the body is wiped and the message shows as removed.
  deletedAt      DateTime?
  /// Body is encrypted at rest (AES-256-GCM, server key). Private messages only.
  encrypted      Boolean   @default(false)

  createdAt DateTime @default(now())

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions    MessageReaction[]
  hiddenFor    MessageHidden[]

  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------------------
// Impact
// ---------------------------------------------------------------------------

model ImpactProject {
  id          String @id @default(cuid())
  title       String
  slug        String @unique
  /// EDUCATION | HEALTHCARE | CLEAN_WATER | COMMUNITY | CONSERVATION
  category    String
  /// DRAFT | ACTIVE | FUNDED | COMPLETED | PAUSED
  status      String @default("DRAFT")
  summary     String
  description String

  location  String
  country   String @default("Tanzania")
  latitude  Float?
  longitude Float?

  /// Integer minor units of `currency`.
  goal             Int
  raised           Int    @default(0)
  currency         String @default("TZS")
  contributorCount Int    @default(0)
  /// Number of people the project is planned to reach. A stated plan, not a
  /// claim of results.
  beneficiaries    Int?

  heroImage  String
  gallery    String @default("[]")
  /// JSON array of { label, percent, note } describing how contributions are
  /// earmarked. Planned allocation — not an audited financial statement.
  allocation String @default("[]")

  /// Implementing partner. Left null until a real partnership is documented.
  partnerName      String?
  partnerNote      String?
  featured         Boolean @default(false)
  isDemo           Boolean @default(false)
  beneficiaryGroup String?
  /// Off until donations to this project are being verified; totals are hidden while off.
  showFunding      Boolean @default(false)
  videoUrl         String?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  donations Donation[]
  updates   ImpactUpdate[]
  trips     Trip[]
  bookings  Booking[]

  @@index([category, status])
}

/// Money given to impact work. Kept entirely apart from the finance ledger:
/// a donation is never business income.
model Donation {
  id           String    @id @default(cuid())
  /// Null for a general donation not tied to one project.
  projectId    String?
  /// Null for guest contributions.
  userId       String?
  /// Set when the contribution was added during trip checkout.
  bookingId    String?
  amount       Int
  currency     String    @default("TZS")
  /// PLEDGED | PENDING | SUCCEEDED | FAILED | REFUNDED. Only SUCCEEDED counts,
  /// and for a bank transfer that means a person has checked the statement.
  status       String    @default("SUCCEEDED")
  anonymous    Boolean   @default(false)
  message      String?
  donorName    String?
  donorPhone   String?
  donorEmail   String?
  /// CHECKOUT | BANK_TRANSFER | MOBILE_MONEY | CASH | OTHER
  method       String    @default("CHECKOUT")
  reference    String?
  receivedAt   DateTime?
  verifiedById String?
  verifiedAt   DateTime?
  notes        String?
  receiptUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  project ImpactProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user    User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  booking Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([userId])
}

/// Progress reports on a project. The transparency promise lives here: goal,
/// raised, and a dated trail of what actually happened.
model ImpactUpdate {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  body        String
  images      String   @default("[]")
  /// Flags a completed milestone rather than a routine note.
  milestone   Boolean  @default(false)
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())

  project ImpactProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, publishedAt])
}

// ---------------------------------------------------------------------------
// Demand capture & messaging
// ---------------------------------------------------------------------------

model CustomTripRequest {
  id            String    @id @default(cuid())
  userId        String?
  contactName   String
  /// Optional because an enquiry may arrive with a phone number instead. The
  /// API requires at least one of the two.
  contactEmail  String?
  contactPhone  String?
  destination   String
  startDate     DateTime?
  endDate       DateTime?
  travellers    Int       @default(2)
  budget        Int?
  currency      String    @default("TZS")
  /// BUDGET | COMFORT | LUXURY
  style         String    @default("COMFORT")
  accommodation String?
  /// JSON string array of requested activities.
  activities    String    @default("[]")
  notes         String?
  /// NEW | MATCHING | QUOTED | CONVERTED | CLOSED
  status        String    @default("NEW")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  type       String
  title      String
  body       String
  link       String?
  read       Boolean   @default(false)
  /// MESSAGES | REQUESTS | UPDATES
  category   String    @default("UPDATES")
  archivedAt DateTime?
  /// Same event twice never makes a second notification for the same person.
  dedupeKey  String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, read])
  @@index([userId, createdAt])
}

/// Key/value store for platform-wide settings an admin can change without a
/// deploy (commission default, demo-data banner, feature flags).
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Geography and categories — the international catalogue
// ---------------------------------------------------------------------------

/// Every country is present from the first deploy, so a new market is opened
/// by publishing listings there, not by asking a developer.
model Country {
  id        String  @id @default(cuid())
  /// ISO 3166-1 alpha-2.
  code      String  @unique
  name      String
  slug      String  @unique
  region    String?
  /// ISO 4217 code of the local currency. Informational: each listing names its own.
  currency  String  @default("USD")
  timezone  String  @default("UTC")
  latitude  Float?
  longitude Float?
  summary   String?
  heroImage String?
  featured  Boolean @default(false)
  /// DRAFT | PUBLISHED | ARCHIVED
  status    String  @default("PUBLISHED")
  sortOrder Int     @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cities      City[]
  trips       Trip[]
  activities  Activity[]
  places      Place[]
  experiences Experience[]
  events      Event[]
  stories     Story[]
  deals       Deal[]
  polls       Poll[]
  challenges  Challenge[]
  communities Community[]
  tournaments Tournament[]

  @@index([status])
}

model City {
  id        String  @id @default(cuid())
  countryId String
  name      String
  slug      String
  /// Empty means the country's zone.
  timezone  String?
  latitude  Float?
  longitude Float?
  /// GeoNames id when the city came from the worldwide dataset.
  geonameId Int?
  summary   String?
  heroImage String?
  featured  Boolean @default(false)
  status    String  @default("PUBLISHED")
  sortOrder Int     @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  country     Country      @relation(fields: [countryId], references: [id], onDelete: Cascade)
  trips       Trip[]
  activities  Activity[]
  places      Place[]
  experiences Experience[]
  events      Event[]
  stories     Story[]
  deals       Deal[]
  polls       Poll[]
  challenges  Challenge[]
  communities Community[]
  tournaments Tournament[]

  @@unique([countryId, slug])
  @@index([status])
}

/// Editable categories for every part of the site. `group` gathers related
/// ones ("Sports", "Console gaming") without a fixed hierarchy.
model Category {
  id          String  @id @default(cuid())
  /// ACTIVITY | PLACE | EXPERIENCE | EVENT | INTEREST
  kind        String
  name        String
  slug        String
  group       String?
  /// Which part of the site lists it: for ACTIVITY/EVENT categories one of the
  /// eight Experiences sections, for PLACE categories one of the Explore sections.
  section     String?
  description String?
  icon        String?
  /// Shown as a main category rather than inside a list.
  featured    Boolean @default(false)
  sortOrder   Int     @default(100)
  status      String  @default("PUBLISHED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities  Activity[]
  places      Place[]
  experiences Experience[]
  events      Event[]
  tournaments Tournament[] @relation("TournamentGame")
  communities Community[]

  @@unique([kind, slug])
  @@index([kind, status])
}

// ---------------------------------------------------------------------------
// Activities — organised by the community or by Enhakkore
// ---------------------------------------------------------------------------

model Activity {
  id           String  @id @default(cuid())
  /// How entry is checked: NONE (default) | QR | MANUAL.
  verification String  @default("NONE")
  /// Group chat for registered participants and the organiser.
  chatEnabled  Boolean @default(false)
  slug         String  @unique
  title        String
  summary      String?
  description  String
  categoryId   String?
  countryId    String?
  cityId       String?

  /// IN_PERSON | ONLINE
  mode          String  @default("IN_PERSON")
  /// A public meeting place. Never a home address.
  meetingPoint  String?
  /// Shared only with approved participants.
  onlineDetails String?
  platformName  String?

  startsAt             DateTime?
  endsAt               DateTime?
  timezone             String    @default("Africa/Dar_es_Salaam")
  recurrence           String?
  /// Applications close at this moment (UTC).
  registrationDeadline DateTime?
  eligibility          String?
  rules                String?
  cancellationTerms    String?
  /// STANDARD | ENHANCED — large, paid or higher-risk activities need enhanced review.
  reviewLevel          String    @default("STANDARD")
  communityId          String?

  capacity     Int?
  spotsTaken   Int     @default(0)
  /// ALL | BEGINNER | INTERMEDIATE | ADVANCED
  level        String  @default("ALL")
  equipment    String?
  requirements String?
  price        Int?
  currency     String  @default("TZS")

  /// ADMIN | COMMUNITY
  source          String  @default("ADMIN")
  organiserName   String
  organiserPhone  String?
  organiserUserId String?
  contactMethod   String?

  /// See ACTIVITY_STATUSES in @enhakkore/shared.
  status      String  @default("DRAFT")
  reviewNotes String?
  coverImage  String?
  gallery     String  @default("[]")
  videoUrl    String?
  featured    Boolean @default(false)
  /// Example content for testing and layout. Shown with a DEMO label, never as real.
  isDemo      Boolean @default(false)

  createdById String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category     Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  country      Country?              @relation(fields: [countryId], references: [id], onDelete: SetNull)
  city         City?                 @relation(fields: [cityId], references: [id], onDelete: SetNull)
  participants ActivityParticipant[]
  sessions     ActivitySession[]
  community    Community?            @relation(fields: [communityId], references: [id], onDelete: SetNull)

  @@index([status, startsAt])
  @@index([countryId, cityId])
  @@index([categoryId])
}

model ActivityParticipant {
  id         String    @id @default(cuid())
  activityId String
  userId     String
  message    String?
  /// REQUESTED | APPROVED | WAITLIST | DECLINED | CANCELLED
  status     String    @default("REQUESTED")
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId])
  @@index([activityId, status])
}

// ---------------------------------------------------------------------------
// Discover, experiences, events, catering
// ---------------------------------------------------------------------------

model Place {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  categoryId  String?
  summary     String?
  description String?
  countryId   String?
  cityId      String?
  area        String?
  address     String?
  latitude    Float?
  longitude   Float?

  /// JSON string arrays.
  facilities       String  @default("[]")
  amenities        String  @default("[]")
  /// JSON array of { days, hours }.
  openingHours     String  @default("[]")
  priceRange       String?
  offers           String?
  /// JSON string array — only room types the property has confirmed.
  roomTypes        String  @default("[]")
  menu             String?
  menuUrl          String?
  /// Only when verified with the business, e.g. "Rooms available for December — confirmed 3 Nov".
  availabilityNote String?

  phone    String?
  whatsapp String?
  email    String?
  website  String?
  /// JSON array of { label, url }.
  socials  String  @default("[]")

  /// ENQUIRY | EXTERNAL | NONE. No payment is ever taken for a third party.
  bookingMode String  @default("ENQUIRY")
  bookingUrl  String?
  /// PLACE | ROOM | TABLE
  enquiryKind String  @default("PLACE")

  coverImage String?
  gallery    String  @default("[]")
  videoUrl   String?

  /// VERIFIED | BUSINESS_SUBMITTED | UNVERIFIED
  infoSource     String    @default("UNVERIFIED")
  lastVerifiedAt DateTime?
  /// Where publicly researched details came from, and when they were checked.
  sourceUrl      String?
  researchedAt   DateTime?
  sponsored      Boolean   @default(false)
  hiddenGem      Boolean   @default(false)
  featured       Boolean   @default(false)
  /// Example content for testing and layout. Shown with a DEMO label, never as real.
  isDemo         Boolean   @default(false)
  /// A partner account allowed to edit this listing.
  managerId      String?
  status         String    @default("DRAFT")

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  country  Country?      @relation(fields: [countryId], references: [id], onDelete: SetNull)
  city     City?         @relation(fields: [cityId], references: [id], onDelete: SetNull)
  reviews  PlaceReview[]
  deals    Deal[]

  @@index([status])
  @@index([countryId, cityId])
  @@index([categoryId])
}

/// A member's review of a place. Held for moderation before it shows.
model PlaceReview {
  id        String   @id @default(cuid())
  placeId   String
  userId    String
  rating    Int
  body      String
  /// PENDING | PUBLISHED | HIDDEN
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([placeId, userId])
  @@index([placeId, status])
}

model Experience {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  categoryId      String?
  summary         String?
  description     String
  countryId       String?
  cityId          String?
  meetingPoint    String?
  durationText    String?
  schedule        String?
  startsAt        DateTime?
  timezone        String    @default("Africa/Dar_es_Salaam")
  price           Int?
  currency        String    @default("TZS")
  priceNote       String?
  inclusions      String    @default("[]")
  exclusions      String    @default("[]")
  provider        String    @default("Enhakkore")
  providerContact String?
  managerId       String?
  coverImage      String?
  gallery         String    @default("[]")
  videoUrl        String?
  featured        Boolean   @default(false)
  /// Example content for testing and layout. Shown with a DEMO label, never as real.
  isDemo          Boolean   @default(false)
  status          String    @default("DRAFT")

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  country  Country?  @relation(fields: [countryId], references: [id], onDelete: SetNull)
  city     City?     @relation(fields: [cityId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([countryId, cityId])
}

model Event {
  id                  String    @id @default(cuid())
  verification        String    @default("NONE")
  chatEnabled         Boolean   @default(false)
  slug                String    @unique
  title               String
  categoryId          String?
  summary             String?
  description         String
  /// ENHAKKORE | THIRD_PARTY
  host                String    @default("ENHAKKORE")
  hostName            String?
  countryId           String?
  cityId              String?
  venue               String?
  address             String?
  startsAt            DateTime
  endsAt              DateTime?
  timezone            String    @default("Africa/Dar_es_Salaam")
  /// ENHAKKORE | EXTERNAL | INFO_ONLY
  registrationMode    String    @default("ENHAKKORE")
  externalUrl         String?
  capacity            Int?
  paymentInstructions String?
  ageRestriction      String?
  dressCode           String?
  managerId           String?
  poster              String?
  gallery             String    @default("[]")
  videoUrl            String?
  featured            Boolean   @default(false)
  /// Example content for testing and layout. Shown with a DEMO label, never as real.
  isDemo              Boolean   @default(false)
  status              String    @default("DRAFT")

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category      Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  country       Country?            @relation(fields: [countryId], references: [id], onDelete: SetNull)
  city          City?               @relation(fields: [cityId], references: [id], onDelete: SetNull)
  tickets       EventTicket[]
  registrations EventRegistration[]

  @@index([status, startsAt])
  @@index([countryId, cityId])
}

model EventTicket {
  id          String  @id @default(cuid())
  eventId     String
  name        String
  description String?
  price       Int     @default(0)
  currency    String  @default("TZS")
  capacity    Int?
  sold        Int     @default(0)
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations EventRegistration[]

  @@index([eventId])
}

/// A place at an event. Seats are claimed when the registration is made and
/// released if it is cancelled, the same way trip departures work.
model EventRegistration {
  id               String    @id @default(cuid())
  reference        String    @unique
  eventId          String
  ticketId         String?
  userId           String?
  name             String
  phone            String
  email            String?
  quantity         Int       @default(1)
  amountDue        Int       @default(0)
  amountPaid       Int       @default(0)
  currency         String    @default("TZS")
  /// PENDING_PAYMENT | CONFIRMED | CANCELLED | REFUNDED
  status           String    @default("PENDING_PAYMENT")
  paymentReference String?
  notes            String?
  checkedInAt      DateTime?
  checkedInCount   Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  event  Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticket EventTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([eventId, status])
}

model CateringPackage {
  id             String  @id @default(cuid())
  slug           String  @unique
  title          String
  /// LUNCHBOX | GROUP | PRIVATE_CHEF
  kind           String  @default("LUNCHBOX")
  summary        String?
  description    String?
  /// JSON array of { name, description }.
  menu           String  @default("[]")
  dietaryOptions String  @default("[]")
  price          Int?
  currency       String  @default("TZS")
  /// PER_PERSON | PER_GROUP | ON_REQUEST
  priceUnit      String  @default("PER_PERSON")
  minPeople      Int?
  groupDiscounts String?
  availability   String?
  serviceAreas   String?
  leadTime       String?
  coverImage     String?
  gallery        String  @default("[]")
  sortOrder      Int     @default(0)
  featured       Boolean @default(false)
  status         String  @default("DRAFT")

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, sortOrder])
}

// ---------------------------------------------------------------------------
// Enquiries — every "contact us about this" in one inbox
// ---------------------------------------------------------------------------

model Enquiry {
  id            String    @id @default(cuid())
  reference     String    @unique
  /// See ENQUIRY_TYPES in @enhakkore/shared.
  type          String    @default("GENERAL")
  subjectType   String?
  subjectId     String?
  subjectTitle  String?
  userId        String?
  name          String
  phone         String?
  email         String?
  startDate     DateTime?
  endDate       DateTime?
  people        Int?
  message       String
  /// JSON object of extra answers (dietary needs, location…).
  details       String    @default("{}")
  /// See ENQUIRY_STATUSES in @enhakkore/shared.
  status        String    @default("NEW")
  /// Automatic WhatsApp notice to the team: NOT_REQUIRED | NOT_CONFIGURED | SENT | FAILED
  notifyStatus  String    @default("NOT_REQUIRED")
  notifyError   String?
  internalNotes String?
  handledById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([type])
}

// ---------------------------------------------------------------------------
// Community content — stories, deals, polls, challenges, banners
// ---------------------------------------------------------------------------

model Story {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  body        String
  authorName  String
  userId      String?
  countryId   String?
  cityId      String?
  coverImage  String?
  gallery     String    @default("[]")
  /// ADMIN | COMMUNITY
  source      String    @default("ADMIN")
  status      String    @default("DRAFT")
  featured    Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  country Country? @relation(fields: [countryId], references: [id], onDelete: SetNull)
  city    City?    @relation(fields: [cityId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
}

model Deal {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  businessName String
  placeId      String?
  description  String?
  terms        String?
  countryId    String?
  cityId       String?
  validFrom    DateTime?
  validUntil   DateTime?
  /// Confirmed with the business. Unverified deals are never shown publicly.
  verified     Boolean   @default(false)
  coverImage   String?
  status       String    @default("DRAFT")
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  place   Place?   @relation(fields: [placeId], references: [id], onDelete: SetNull)
  country Country? @relation(fields: [countryId], references: [id], onDelete: SetNull)
  city    City?    @relation(fields: [cityId], references: [id], onDelete: SetNull)

  @@index([status])
}

model Poll {
  id          String    @id @default(cuid())
  question    String
  description String?
  /// JSON string array.
  options     String    @default("[]")
  countryId   String?
  cityId      String?
  closesAt    DateTime?
  /// DRAFT | OPEN | CLOSED | ARCHIVED
  status      String    @default("DRAFT")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  country Country?   @relation(fields: [countryId], references: [id], onDelete: SetNull)
  city    City?      @relation(fields: [cityId], references: [id], onDelete: SetNull)
  votes   PollVote[]

  @@index([status])
}

/// One vote per member per poll, enforced by the database.
model PollVote {
  id          String   @id @default(cuid())
  pollId      String
  userId      String
  optionIndex Int
  createdAt   DateTime @default(now())

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
}

model Challenge {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  description   String
  howToTakePart String?
  countryId     String?
  cityId        String?
  startsAt      DateTime?
  endsAt        DateTime?
  coverImage    String?
  status        String    @default("DRAFT")
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  country Country? @relation(fields: [countryId], references: [id], onDelete: SetNull)
  city    City?    @relation(fields: [cityId], references: [id], onDelete: SetNull)

  @@index([status])
}

model Banner {
  id        String    @id @default(cuid())
  message   String
  linkLabel String?
  linkUrl   String?
  /// SITE_TOP | HOME
  placement String    @default("SITE_TOP")
  /// NAVY | GOLD | CREAM
  tone      String    @default("NAVY")
  imageUrl  String?
  startsAt  DateTime?
  endsAt    DateTime?
  status    String    @default("DRAFT")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Media library
// ---------------------------------------------------------------------------

model MediaAsset {
  id          String   @id @default(cuid())
  url         String
  /// IMAGE | VIDEO
  kind        String   @default("IMAGE")
  title       String?
  alt         String?
  caption     String?
  credit      String?
  folder      String   @default("General")
  /// Storage id for uploaded files; null for files that ship with the site.
  assetId     String?
  bytes       Int?
  format      String?
  /// Part of the site's own files (logos, the Mkuranga outreach photographs).
  /// Cannot be deleted from the dashboard.
  isSystem    Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([folder])
  @@index([kind])
}

// ---------------------------------------------------------------------------
// Connect — members finding each other
// ---------------------------------------------------------------------------

model Connection {
  id          String    @id @default(cuid())
  requesterId String
  addresseeId String
  /// PENDING | ACCEPTED | DECLINED
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  requester User @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("ConnectionAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

/// A report about a member or a listing, for the community team.
model Report {
  id          String   @id @default(cuid())
  reporterId  String?
  /// USER | ACTIVITY | PLACE | EVENT | STORY | REVIEW
  targetType  String
  targetId    String
  reason      String
  details     String?
  /// OPEN | REVIEWING | RESOLVED | DISMISSED
  status      String   @default("OPEN")
  resolution  String?
  handledById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

/// Wishlist: any listing a member wants to come back to.
model SavedItem {
  id        String   @id @default(cuid())
  userId    String
  /// TRIP | PLACE | EXPERIENCE | EVENT | ACTIVITY | COUNTRY | CITY
  itemType  String
  itemId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemId])
}

// ---------------------------------------------------------------------------
// Staff, sessions and the audit trail
// ---------------------------------------------------------------------------

model AdminRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  /// JSON string array of permissions, e.g. ["finance.*", "trips.view"].
  permissions String   @default("[]")
  /// ALL | OWN — OWN limits listings to those assigned to the person.
  scope       String   @default("ALL")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users   User[]
  members UserAdminRole[]
}

/// A signed-in session. Every token names its session, so a session can be
/// revoked — signing someone out everywhere — without waiting for it to expire.
model Session {
  id         String    @id @default(cuid())
  userId     String
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  revokedBy  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  success   Boolean
  /// ok | bad_password | unknown_account | suspended | rate_limited
  reason    String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([email])
}

/// Who changed what, and when. Written by the API on every administrative
/// change; never edited or deleted from the dashboard.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorName  String?
  /// create | update | delete | status | settings | permissions | payment | export | security | finance | donation
  action     String
  entityType String
  entityId   String?
  summary    String
  /// JSON snapshots, secrets removed.
  before     String?
  after      String?
  sensitive  Boolean  @default(false)
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorId])
}

// ---------------------------------------------------------------------------
// Payment settings and the finance ledger
// ---------------------------------------------------------------------------

/// How customers and donors pay. Holds only what a customer is shown — an
/// account name and number — never a password, PIN or API key.
model PaymentMethod {
  id                String   @id @default(cuid())
  name              String
  /// BANK_TRANSFER | MOBILE_MONEY | CASH | PAYMENT_LINK | OTHER
  kind              String   @default("BANK_TRANSFER")
  provider          String?
  accountName       String?
  accountNumber     String?
  extraDetails      String?
  /// JSON string arrays.
  currencies        String   @default("[]")
  scopes            String   @default("[]")
  instructions      String?
  referenceFormat   String?
  verificationSteps String?
  isDefault         Boolean  @default(false)
  sortOrder         Int      @default(0)
  /// ENABLED | DISABLED
  status            String   @default("ENABLED")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// One line in Enhakkore's books. Income, expenses and refunds only —
/// donations live in their own table and never appear here.
model FinanceTransaction {
  id             String    @id @default(cuid())
  /// INCOME | EXPENSE | REFUND
  type           String
  date           DateTime
  /// Integer minor units of `currency`. Always positive; `type` gives the sign.
  amount         Int
  currency       String
  division       String    @default("OTHER")
  category       String
  /// NONE | TRIP_DEPARTURE | EVENT | EXPERIENCE | ACTIVITY | PLACE | CATERING
  relatedType    String    @default("NONE")
  relatedId      String?
  relatedLabel   String?
  paymentMethod  String?
  reference      String?
  counterparty   String?
  notes          String?
  /// PENDING | VERIFIED | CANCELLED
  status         String    @default("PENDING")
  receiptUrl     String?
  /// Set when the line was written by a verified booking or registration payment.
  bookingId      String?
  registrationId String?
  paymentId      String?
  createdById    String?
  verifiedById   String?
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([date])
  @@index([type, status])
  @@index([relatedType, relatedId])
  @@index([division])
}

// ---------------------------------------------------------------------------
// Experiences: recurring sessions, communities, gaming
// ---------------------------------------------------------------------------

/// One dated session of a recurring activity (e.g. one Saturday's jog).
model ActivitySession {
  id           String    @id @default(cuid())
  activityId   String
  startsAt     DateTime
  endsAt       DateTime?
  meetingPoint String?
  route        String?
  capacity     Int?
  /// SCHEDULED | CHANGED | CANCELLED | COMPLETED
  status       String    @default("SCHEDULED")
  /// Shown to registered members when the plan changes.
  notice       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activity      Activity              @relation(fields: [activityId], references: [id], onDelete: Cascade)
  registrations SessionRegistration[]

  @@index([activityId, startsAt])
}

model SessionRegistration {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  /// REGISTERED | CANCELLED
  status    String   @default("REGISTERED")
  attended  Boolean  @default(false)
  createdAt DateTime @default(now())

  session ActivitySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
}

model Community {
  id                 String  @id @default(cuid())
  /// FREE | PAID | PRIVATE. Paid membership needs admin approval; payments stay off until a merchant account is configured.
  accessType         String  @default("FREE")
  membershipPrice    Int?
  membershipCurrency String?
  /// MONTH | YEAR | ONCE
  membershipPeriod   String?
  membershipBenefits String?
  membershipTerms    String?
  chatEnabled        Boolean @default(false)
  /// COMMUNITY | STUDY_GROUP. Study groups are created by members without prior approval.
  kind               String  @default("COMMUNITY")
  /// Run by Enhakkore (starter communities).
  official           Boolean @default(false)
  /// Study groups: subject or field, topic and optional school.
  subject            String?
  topic              String?
  institution        String?
  /// IN_PERSON | ONLINE | BOTH
  mode               String  @default("IN_PERSON")
  /// A plain-language timetable, e.g. "Every Saturday 06:30".
  schedule           String?
  meetingPoint       String?
  /// Kept in draft until the team verifies the place or route.
  meetingVerified    Boolean @default(true)
  slug               String  @unique
  name               String
  summary            String?
  description        String?
  categoryId         String?
  countryId          String?
  cityId             String?
  coverImage         String?
  rules              String?
  /// PENDING_REVIEW | DRAFT | PUBLISHED | REJECTED | ARCHIVED
  status             String  @default("DRAFT")
  reviewNotes        String?
  createdById        String?
  featured           Boolean @default(false)
  /// Example content for testing and layout. Shown with a DEMO label, never as real.
  isDemo             Boolean @default(false)
  /// Private communities and study groups: bcrypt hash of the joining password. Never shown.
  passwordHash       String?
  /// Creator contact, visible only to the team.
  contactName        String?
  contactPhone       String?
  /// Study groups: course, learning objectives and search tags (JSON array).
  course             String?
  objectives         String?
  tags               String  @default("[]")
  /// Why the team suspended or restricted it.
  moderationReason   String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category      Category?               @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  country       Country?                @relation(fields: [countryId], references: [id], onDelete: SetNull)
  city          City?                   @relation(fields: [cityId], references: [id], onDelete: SetNull)
  members       CommunityMember[]
  announcements CommunityAnnouncement[]
  activities    Activity[]
  invites       CommunityInvite[]
  sessions      GroupSession[]
  resources     GroupResource[]

  @@index([status])
}

model CommunityMember {
  id          String    @id @default(cuid())
  communityId String
  userId      String
  /// MEMBER | MODERATOR | ADMIN (the creator of a study group)
  role        String    @default("MEMBER")
  /// A muted member can read but not post until this time.
  mutedUntil  DateTime?
  /// ACTIVE | PENDING (private or paid communities wait for approval) | DECLINED
  status      String    @default("ACTIVE")
  /// What the member wrote when asking to join.
  message     String?
  joinedAt    DateTime  @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([userId])
}

model CommunityAnnouncement {
  id          String   @id @default(cuid())
  communityId String
  authorId    String?
  title       String
  body        String
  createdAt   DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([communityId, createdAt])
}

/// A gaming tournament or a console gaming session. Free at launch.
model Tournament {
  id                     String    @id @default(cuid())
  slug                   String    @unique
  title                  String
  /// A category of kind GAME.
  gameId                 String?
  /// ONLINE | CONSOLE
  kind                   String    @default("ONLINE")
  /// SOLO | DUO | SQUAD | TEAM
  format                 String    @default("SOLO")
  teamSize               Int       @default(1)
  summary                String?
  description            String?
  startsAt               DateTime?
  timezone               String    @default("Africa/Dar_es_Salaam")
  registrationDeadline   DateTime?
  server                 String?
  region                 String?
  venue                  String?
  countryId              String?
  cityId                 String?
  slots                  Int?
  entryRequirements      String?
  rules                  String?
  disputeProcedure       String?
  minAge                 Int?
  organiserName          String    @default("Enhakkore")
  /// JSON array of { round, match, result } rows.
  bracket                String    @default("[]")
  results                String?
  coverImage             String?
  /// DRAFT | REGISTRATION_OPEN | REGISTRATION_CLOSED | IN_PROGRESS | COMPLETED | CANCELLED | ARCHIVED
  status                 String    @default("DRAFT")
  featured               Boolean   @default(false)
  /// Example content for testing and layout. Shown with a DEMO label, never as real.
  isDemo                 Boolean   @default(false)
  /// FRIENDLY | GUILD | ESPORTS | CREATOR | OTHER
  category               String    @default("FRIENDLY")
  /// INDIVIDUAL | GUILD | SQUAD | COMMUNITY_ADMIN | CREATOR | ESPORTS_ORG | COMPANY | INSTITUTION | SPONSOR | OTHER
  organiserType          String    @default("INDIVIDUAL")
  createdById            String?
  /// Organiser contact — visible only to the organiser and the team.
  contactName            String?
  contactPhone           String?
  contactEmail           String?
  platform               String?
  /// SINGLE_ELIMINATION | DOUBLE_ELIMINATION | LEAGUE | ROUND_ROBIN
  bracketFormat          String    @default("SINGLE_ELIMINATION")
  prizeDetails           String?
  /// Team checks (not approval: member tournaments publish immediately).
  checkedAt              DateTime?
  checkedById            String?
  registrationRestricted Boolean   @default(false)
  moderationReason       String?
  esportsOrganiserId     String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  game    Category?         @relation("TournamentGame", fields: [gameId], references: [id], onDelete: SetNull)
  country Country?          @relation(fields: [countryId], references: [id], onDelete: SetNull)
  city    City?             @relation(fields: [cityId], references: [id], onDelete: SetNull)
  entries TournamentEntry[]
  matches TournamentMatch[]
  notes   TournamentNote[]

  @@index([status, startsAt])
}

/// One registration: a solo player, or a team led by its captain.
model TournamentEntry {
  id           String   @id @default(cuid())
  reference    String   @unique
  tournamentId String
  captainId    String
  teamName     String?
  playerName   String
  gameUid      String
  server       String?
  /// Members join a team with this code.
  inviteCode   String?  @unique
  agreedRules  Boolean  @default(false)
  /// REGISTERED | CONFIRMED | WAITLIST | DISQUALIFIED | WITHDRAWN
  status       String   @default("REGISTERED")
  adminNotes   String?
  /// Bracket position (1 = top seed).
  seed         Int?
  createdAt    DateTime @default(now())

  tournament Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  captain    User                   @relation(fields: [captainId], references: [id], onDelete: Cascade)
  members    TournamentTeamMember[]

  @@unique([tournamentId, captainId])
  @@index([tournamentId, status])
}

model TournamentTeamMember {
  id         String   @id @default(cuid())
  entryId    String
  userId     String
  playerName String
  gameUid    String
  joinedAt   DateTime @default(now())

  entry TournamentEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([entryId, userId])
}

// ---------------------------------------------------------------------------
// Partnerships, popularity, notification delivery
// ---------------------------------------------------------------------------

/// What Enhakkore agreed with a business: editorial, sponsored or referral.
model PartnerAgreement {
  id             String    @id @default(cuid())
  businessName   String
  placeId        String?
  enquiryRef     String?
  /// EDITORIAL | SPONSORED | REFERRAL | VENUE | GAMING | OTHER
  kind           String    @default("REFERRAL")
  commissionRate Float?
  fixedFee       Int?
  currency       String    @default("TZS")
  terms          String?
  startsOn       DateTime?
  endsOn         DateTime?
  contactName    String?
  contactPhone   String?
  /// NEGOTIATING | ACTIVE | ENDED | CANCELLED
  status         String    @default("NEGOTIATING")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
}

/// One engagement signal. A visitor is counted once per kind, item and day,
/// so refreshing a page does not raise its ranking.
model EngagementEvent {
  id          String   @id @default(cuid())
  subjectType String
  subjectId   String
  /// VIEW | SAVE | SHARE | REGISTER | ENQUIRY
  kind        String
  visitor     String
  day         String
  createdAt   DateTime @default(now())

  @@unique([subjectType, subjectId, kind, visitor, day])
  @@index([subjectType, subjectId])
  @@index([createdAt])
}

/// Every attempt to send an email or WhatsApp notice, and what happened.
model NotificationDelivery {
  id          String   @id @default(cuid())
  /// WHATSAPP | EMAIL
  channel     String
  recipient   String
  subjectType String?
  subjectId   String?
  summary     String
  /// SENT | FAILED | NOT_CONFIGURED
  status      String
  providerId  String?
  error       String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

/// A member's application to host experiences. Approval is per category and per risk.
model OrganiserApplication {
  id                 String    @id @default(cuid())
  userId             String
  legalName          String
  phone              String
  email              String
  country            String?
  city               String?
  /// JSON list of experience sections applied for, e.g. ["SPORTS","GAMING"].
  categories         String    @default("[]")
  /// JSON list of sections approved — may be fewer than applied for.
  approvedCategories String    @default("[]")
  hasExperience      Boolean   @default(false)
  description        String
  links              String?
  agreedRules        Boolean   @default(false)
  /// How identity was checked by staff (e.g. "Video call, national ID seen") — no ID numbers or images are stored.
  identityCheck      String?
  identityCheckedAt  DateTime?
  /// SUBMITTED | UNDER_REVIEW | MORE_INFO | APPROVED | REJECTED | SUSPENDED
  status             String    @default("SUBMITTED")
  reviewNotes        String?
  reviewedById       String?
  reviewedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

/// An Enhakkore Pass: one per eligible registration or booking. The QR holds only a random token.
model Pass {
  id            String    @id @default(cuid())
  reference     String    @unique
  token         String    @unique
  userId        String?
  /// EVENT_REGISTRATION | SESSION_REGISTRATION | ACTIVITY_PARTICIPANT | TOURNAMENT_ENTRY | BOOKING | ENQUIRY
  subjectType   String
  subjectId     String
  /// The listing it admits to (for organiser scanners): ACTIVITY | EVENT | TOURNAMENT | TRIP | PLACE
  listingType   String
  listingId     String
  title         String
  holderName    String
  startsAt      DateTime?
  location      String?
  qr            Boolean   @default(true)
  /// VALID | CHECKED_IN | CANCELLED | EXPIRED
  status        String    @default("VALID")
  checkedInAt   DateTime?
  checkedInById String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  scans PassScan[]

  @@unique([subjectType, subjectId])
  @@index([userId])
  @@index([listingType, listingId])
}

/// Every check-in attempt, online or synchronised from an offline scanner.
model PassScan {
  id          String   @id @default(cuid())
  passId      String?
  attempted   String
  /// VALID | ALREADY_CHECKED_IN | CANCELLED | EXPIRED | NOT_FOUND | REVIEW
  result      String
  scannedById String
  offline     Boolean  @default(false)
  scannedAt   DateTime @default(now())

  pass Pass? @relation(fields: [passId], references: [id], onDelete: SetNull)

  @@index([passId])
}

/// A payment receipt a member uploads for a trip deposit or balance. It is
/// evidence for the team to check — never proof of payment on its own.
model PaymentReceipt {
  id             String    @id @default(cuid())
  reference      String    @unique
  bookingId      String
  userId         String
  amount         Int
  currency       String
  /// The authorised payment method the member says they used.
  methodName     String
  payerPhone     String?
  /// The transaction ID from the member's M-Pesa / bank message.
  transactionRef String?
  /// Private upload (PAYMENT_RECEIPT); opened only through a checked link.
  fileAssetId    String?
  fileFormat     String?
  /// SUBMITTED | UNDER_VERIFICATION | APPROVED | REJECTED
  status         String    @default("SUBMITTED")
  reviewNote     String?
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([bookingId])
}

/// The admin assistant's history: every request, and every action it proposed
/// or carried out. Kept for accountability.
model AssistantEntry {
  id        String   @id @default(cuid())
  userId    String
  /// BETHANY (working) | ARIEL (reporting, read-only)
  mode      String
  prompt    String
  reply     String   @default("")
  /// JSON list of tool calls: { tool, input, result, ok }
  actions   String   @default("[]")
  /// A sensitive action waiting for the person to confirm: { tool, input, summary }
  pending   String?
  /// DONE | AWAITING_CONFIRMATION | CONFIRMED | CANCELLED | FAILED | NOT_CONFIGURED
  status    String   @default("DONE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// R8 — Account Centre phases 1A–1H
// ---------------------------------------------------------------------------

/// A staff member may hold several roles; permissions are the union.
model UserAdminRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

/// One-way follow. Follows in both directions allow a message request.
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

/// "Delete for me": the message stays for everyone else.
model MessageHidden {
  id        String @id @default(cuid())
  messageId String
  userId    String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

/// Invitation links to private communities and study groups. Only a hash of the token is stored.
model CommunityInvite {
  id          String    @id @default(cuid())
  communityId String
  tokenHash   String    @unique
  createdById String
  expiresAt   DateTime?
  maxUses     Int?
  uses        Int       @default(0)
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([communityId])
}

/// Study sessions and community meet-ups with RSVP and reminders.
model GroupSession {
  id             String    @id @default(cuid())
  communityId    String
  title          String
  description    String?
  /// ONLINE | PHYSICAL | HYBRID
  mode           String    @default("ONLINE")
  startsAt       DateTime
  endsAt         DateTime?
  location       String?
  link           String?
  createdById    String
  reminderSentAt DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime  @default(now())

  community Community          @relation(fields: [communityId], references: [id], onDelete: Cascade)
  rsvps     GroupSessionRsvp[]

  @@index([communityId, startsAt])
  @@index([startsAt, reminderSentAt])
}

model GroupSessionRsvp {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  /// GOING | MAYBE | NOT_GOING
  status    String   @default("GOING")
  createdAt DateTime @default(now())

  session GroupSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
}

/// Shared notes, files and links of a study group or community.
model GroupResource {
  id          String    @id @default(cuid())
  communityId String
  /// NOTE | FILE | LINK
  kind        String    @default("NOTE")
  title       String
  body        String?
  url         String?
  createdById String
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([communityId])
}

model TournamentMatch {
  id               String    @id @default(cuid())
  tournamentId     String
  /// WINNERS | LOSERS | GRAND_FINAL | LEAGUE
  stage            String    @default("WINNERS")
  round            Int
  position         Int
  homeEntryId      String?
  awayEntryId      String?
  homeScore        Int?
  awayScore        Int?
  winnerEntryId    String?
  /// PENDING | READY | COMPLETED | BYE
  status           String    @default("PENDING")
  nextMatchId      String?
  /// HOME | AWAY
  nextSlot         String?
  loserNextMatchId String?
  loserNextSlot    String?
  scheduledAt      DateTime?
  disputed         Boolean   @default(false)
  reportedById     String?
  updatedAt        DateTime  @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId, stage, round])
}

/// Team follow-up notes on a tournament (contact made, information requested, checks).
model TournamentNote {
  id           String   @id @default(cuid())
  tournamentId String
  authorId     String
  /// NOTE | CONTACT | INFO_REQUEST | CHECK
  kind         String   @default("NOTE")
  body         String
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
}

/// "Register as an Esports Organiser" applications and their verification.
model EsportsOrganiser {
  id                 String    @id @default(cuid())
  userId             String
  organisationName   String
  representativeName String
  representativeRole String
  phone              String
  email              String
  country            String
  location           String?
  website            String?
  /// JSON array of official social accounts.
  socials            String    @default("[]")
  history            String
  /// JSON array of games.
  games              String    @default("[]")
  authorityEvidence  String
  /// JSON array of private file asset ids.
  documents          String    @default("[]")
  /// PENDING | MORE_INFO | VERIFIED | REJECTED | SUSPENDED | EXPIRED
  status             String    @default("PENDING")
  reviewNote         String?
  reviewedById       String?
  reviewedAt         DateTime?
  verifiedUntil      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status])
  @@index([userId])
}

/// Casual matches, practice, training and meet-ups — separate from tournaments.
model GamingSession {
  id             String    @id @default(cuid())
  slug           String    @unique
  organiserId    String
  title          String
  game           String
  platform       String
  /// ONLINE | PHYSICAL
  mode           String    @default("ONLINE")
  /// CASUAL | PRACTICE | TRAINING | MEETUP | MULTIPLAYER
  sessionType    String    @default("CASUAL")
  startsAt       DateTime
  endsAt         DateTime?
  capacity       Int
  location       String?
  onlinePlatform String?
  description    String?
  /// OPEN | FULL | CANCELLED | COMPLETED | HIDDEN
  status         String    @default("OPEN")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  players GamingSessionPlayer[]

  @@index([status, startsAt])
}

model GamingSessionPlayer {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  joinedAt  DateTime @default(now())

  session GamingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
}

/// Guilds contain squads; teams stand alone.
model GamingGroup {
  id          String   @id @default(cuid())
  slug        String   @unique
  /// GUILD | SQUAD | TEAM
  kind        String
  parentId    String?
  name        String
  game        String?
  description String?
  ownerId     String
  /// PUBLIC (anyone may ask to join) | INVITE (invitation only)
  privacy     String   @default("PUBLIC")
  /// ACTIVE | SUSPENDED
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   GamingGroup?        @relation("GuildSquads", fields: [parentId], references: [id], onDelete: SetNull)
  children GamingGroup[]       @relation("GuildSquads")
  members  GamingGroupMember[]

  @@index([kind, status])
}

model GamingGroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  /// OWNER | CAPTAIN | MEMBER
  role     String   @default("MEMBER")
  /// ACTIVE | PENDING (asked to join) | INVITED
  status   String   @default("ACTIVE")
  joinedAt DateTime @default(now())

  group GamingGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

/// A call for players: nearby (2 km), to game friends, or by an outside link.
model GameInvite {
  id             String   @id @default(cuid())
  /// NEARBY | FRIENDS | EXTERNAL
  kind           String
  requesterId    String
  game           String
  platform       String
  slotsNeeded    Int
  /// Decremented atomically; the invitation fills when it reaches 0.
  slotsRemaining Int
  playStyle      String?
  message        String?
  /// An approximate area in words ("near Mlimani City"). Never coordinates.
  meetingArea    String?
  expiresAt      DateTime
  /// OPEN | FULL | EXPIRED | CANCELLED
  status         String   @default("OPEN")
  /// EXTERNAL: sha256 of the link token. The link never carries location or contact details.
  tokenHash      String?  @unique
  /// NEARBY: the requester's approximate grid point, used only for matching.
  gridLat        Float?
  gridLng        Float?
  conversationId String?  @unique
  createdAt      DateTime @default(now())

  responses  GameInviteResponse[]
  recipients GameInviteRecipient[]

  @@index([status, expiresAt])
  @@index([requesterId])
}

/// Who was told about an invitation (nearby members or friends). Never shown to the requester.
model GameInviteRecipient {
  id         String   @id @default(cuid())
  inviteId   String
  userId     String
  notifiedAt DateTime @default(now())

  invite GameInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  @@unique([inviteId, userId])
  @@index([userId])
}

/// Accepts and declines. Declines are never shown to the requester.
model GameInviteResponse {
  id        String   @id @default(cuid())
  inviteId  String
  userId    String
  /// ACCEPTED | DECLINED
  status    String
  createdAt DateTime @default(now())

  invite GameInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  @@unique([inviteId, userId])
}

/// Browser push subscriptions (Web Push). Removed when the browser rejects them.
model PushSubscription {
  id            String    @id @default(cuid())
  userId        String
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?
  lastSuccessAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId])
}

/// The member's own activity history (Activity Centre). Not an official record.
model MemberActivity {
  id          String   @id @default(cuid())
  userId      String
  /// e.g. JOINED_COMMUNITY, JOINED_STUDY_GROUP, TOURNAMENT_REGISTERED, FRIEND_ADDED
  action      String
  subjectType String?
  subjectId   String?
  title       String
  link        String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model NiaConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New conversation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages NiaMessage[]

  @@index([userId, updatedAt])
}

model NiaMessage {
  id             String   @id @default(cuid())
  conversationId String
  /// USER | NIA
  role           String
  content        String
  /// JSON array of the real records Nia found ({ type, title, link }).
  results        String   @default("[]")
  createdAt      DateTime @default(now())

  conversation NiaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// Daily use per member, for the admin's usage limit (counted even with history off).
model NiaUsage {
  id     String @id @default(cuid())
  userId String
  day    String
  count  Int    @default(0)

  @@unique([userId, day])
}
