# ---------------------------------------------------------------------------
# Enhakkore API — local development configuration
# Copy to .env and adjust. Never commit a real .env.
# ---------------------------------------------------------------------------

# SQLite is the zero-setup development database. For staging/production switch
# the provider in prisma/schema.prisma to postgresql and point this at your
# instance, e.g. postgresql://user:pass@host:5432/enhakkore
DATABASE_URL="file:./dev.db"

PORT=4000
NODE_ENV=development

# Signing key for session tokens. Generate a real one for any shared environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="dev-only-change-me"
JWT_EXPIRES_IN="7d"

# Comma-separated list of origins allowed to call the API.
CORS_ORIGIN="http://localhost:3000"

# Seeds the database with demonstration content and flags every generated
# record as demo data so the UI can label it. Set to false for real data.
SEED_DEMO_DATA=true

# Payment gateway selection. "mock" settles payments in-process for development.
# No real payment provider is connected in this build — wiring one means adding
# an adapter in src/services/payments and switching this value.
PAYMENT_PROVIDER=mock
