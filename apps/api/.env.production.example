# Connection string for your REMOTE database (Neon, Supabase, Railway…).
#
# Copy this file to .env.production and paste your own string in. That file is
# gitignored, so it will never be committed.
#
# Used only by the remote:* commands:
#   npm run remote:push     create the tables
#   npm run remote:seed     load the demonstration content
#   npm run remote:studio   browse the data
#
# Your local development database is unaffected — npm run dev still uses SQLite.

DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"
